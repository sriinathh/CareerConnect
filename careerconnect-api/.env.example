# =============================================================================
# CareerConnect Backend Environment Variables (.env)
# Copy this file to .env and adjust values for your local environment
# =============================================================================

# Server Port
SERVER_PORT=8080

# Spring Profiles: dev / prod / test
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerconnect_db
DB_USERNAME=careerconnect_user
DB_PASSWORD=careerconnect_secure_password_2026

# JWT Authentication Configuration
# MUST be a 256-bit (32-byte) or longer secure random string in production
JWT_SECRET=careerconnect_super_secret_jwt_key_with_at_least_256_bits_length_cse_project_2026
# Expiration: 86400000 ms = 24 hours
JWT_EXPIRATION_MS=86400000

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Configuration (Local Storage Directory for Resumes)
FILE_UPLOAD_DIR=./uploads/resumes
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB
